# Скопируйте в .env и заполните. Файл .env в git не коммитится.

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ Claude API: https://platform.claude.com/ → API Keys
ANTHROPIC_API_KEY=

# --- необязательные настройки ---

# Модель. По умолчанию claude-opus-5.
# Дешевле/быстрее: claude-sonnet-5 или claude-haiku-4-5
CLAUDE_MODEL=claude-sonnet-5

# Глубина рассуждений: low | medium | high | xhigh | max
# medium — хороший баланс скорости и качества для чат-бота
CLAUDE_EFFORT=medium

# Максимум токенов в ответе
MAX_TOKENS=4096

# Сколько последних сообщений держать в контексте диалога
HISTORY_LIMIT=30

# Системный промпт — характер бота
SYSTEM_PROMPT=Ты — дружелюбный ассистент в Telegram. Отвечай по-русски, кратко и по делу. Не используй Markdown-разметку: Telegram показывает текст как есть.

# Белый список: ID пользователей через запятую. Пусто = доступ всем.
# Свой ID можно узнать командой /id в боте.
ALLOWED_USER_IDS=
